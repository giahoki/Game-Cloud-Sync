<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GameCloudSync.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:GameCloudSync.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GameCloudSync"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16,4,16,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Google Drive  -->
        <Border
            Padding="16,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    x:Name="DriveIcon"
                    FontSize="28"
                    Glyph="&#xE753;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Google Drive" />
                    <TextBlock
                        x:Name="DriveStatus"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind core:L.T('drive.checking')}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ProgressRing
                        x:Name="Busy"
                        Width="20"
                        Height="20"
                        IsActive="False" />
                    <Button
                        x:Name="ConnectButton"
                        Click="Connect_Click"
                        Content="{x:Bind core:L.T('btn.connect')}"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        x:Name="DisconnectButton"
                        Click="Disconnect_Click"
                        Content="{x:Bind core:L.T('btn.disconnect')}"
                        Visibility="Collapsed" />
                    <Button
                        AutomationProperties.Name="{x:Bind core:L.T('settings.title')}"
                        Click="Settings_Click"
                        ToolTipService.ToolTip="{x:Bind core:L.T('settings.title')}">
                        <FontIcon FontSize="16" Glyph="&#xE713;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Действия  -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Click="SaveChecked_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind core:L.T('btn.saveChecked.tip')}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE898;" />
                        <TextBlock Text="{x:Bind core:L.T('btn.saveChecked')}" />
                    </StackPanel>
                </Button>
                <Button Click="LoadChecked_Click" ToolTipService.ToolTip="{x:Bind core:L.T('btn.loadChecked.tip')}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE896;" />
                        <TextBlock Text="{x:Bind core:L.T('btn.loadChecked')}" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.Name="{x:Bind core:L.T('btn.refresh')}"
                    Click="Refresh_Click"
                    ToolTipService.ToolTip="{x:Bind core:L.T('btn.refresh')}">
                    <FontIcon FontSize="16" Glyph="&#xE72C;" />
                </Button>
            </StackPanel>
            <ToggleSwitch
                x:Name="AutoToggle"
                Grid.Column="1"
                VerticalAlignment="Center"
                OffContent="{x:Bind core:L.T('auto.off')}"
                OnContent="{x:Bind core:L.T('auto.on')}"
                Toggled="AutoToggle_Toggled" />
        </Grid>

        <!--  Игры  -->
        <Border
            Grid.Row="2"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid
                    Padding="16,6,16,6"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                    <CheckBox
                        x:Name="SelectAllBox"
                        Click="SelectAll_Click"
                        Content="{x:Bind core:L.T('list.selectAll')}"
                        IsThreeState="True" />
                    <TextBlock
                        x:Name="CheckedCountText"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </Grid>
                <ListView
                    x:Name="GamesList"
                    Grid.Row="1"
                    Padding="0,4"
                    SelectionChanged="GamesList_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:GameItem">
                            <Grid Padding="4,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    MinWidth="0"
                                    VerticalAlignment="Center"
                                    IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                    ToolTipService.ToolTip="{x:Bind core:L.T('list.checkTip')}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border
                                            Padding="6,0"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="4">
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind StoreLabel}" />
                                        </Border>
                                        <TextBlock
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind SavesInfo, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    MinWidth="110"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind core:L.T('list.lastBackup')}" />
                                    <TextBlock HorizontalAlignment="Right" Text="{x:Bind LastBackup, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <Button Click="SaveGame_Click" Tag="{x:Bind}" ToolTipService.ToolTip="{x:Bind core:L.T('btn.save.tip')}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="14" Glyph="&#xE898;" />
                                            <TextBlock Text="{x:Bind core:L.T('btn.save')}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="LoadGame_Click" Tag="{x:Bind}" ToolTipService.ToolTip="{x:Bind core:L.T('btn.load.tip')}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="14" Glyph="&#xE896;" />
                                            <TextBlock Text="{x:Bind core:L.T('btn.load')}" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="{x:Bind core:L.T('btn.more')}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ToolTipService.ToolTip="{x:Bind core:L.T('btn.more')}">
                                        <FontIcon FontSize="14" Glyph="&#xE712;" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem Click="AddFolder_Click" Tag="{x:Bind}" Text="{x:Bind core:L.T('btn.customFolder')}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8F4;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Click="ClearFolders_Click" Tag="{x:Bind}" Text="{x:Bind core:L.T('btn.clearCustom')}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE894;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Spacing="8">
        <!--  Ход текущей операции  -->
        <Border
            x:Name="ProgressPanel"
            Padding="16,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <Grid ColumnSpacing="16" RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="ProgressText"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="ProgressPercent"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ProgressBar
                    x:Name="ProgressBarControl"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Center"
                    Maximum="100" />
                <Button
                    x:Name="CancelButton"
                    Grid.RowSpan="2"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Click="Cancel_Click"
                    Content="{x:Bind core:L.T('dlg.cancel')}" />
            </Grid>
        </Border>
        <InfoBar
            x:Name="StatusBar"
            IsClosable="True"
            IsOpen="False" />
        <TextBlock
            x:Name="PathsText"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            IsTextSelectionEnabled="True"
            Text="{x:Bind core:L.T('paths.hint')}"
            TextWrapping="Wrap" />
        </StackPanel>

        <Expander
            x:Name="LogExpander"
            Grid.Row="4"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Header="{x:Bind core:L.T('log.header')}"
            IsExpanded="True">
            <TextBox
                x:Name="LogBox"
                Height="130"
                AcceptsReturn="True"
                FontFamily="Consolas"
                FontSize="12"
                IsReadOnly="True"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                TextWrapping="Wrap" />
        </Expander>
    </Grid>
</Page>
